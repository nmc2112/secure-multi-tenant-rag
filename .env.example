# lexical mode runs without model downloads; semantic enables embeddings/Qdrant/reranking
RETRIEVER=lexical
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK=1
QDRANT_PATH=./.qdrant
# Optional OpenAI-compatible API: leave blank for extractive fallback
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
